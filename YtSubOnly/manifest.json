{
  "manifest_version": 3,
  "name": "Youtube Subscription Only",
  "description": "Chrome extension that removes YouTube FYP and sidebar FYP",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["js/index.js"]
    }
  ],
  "icons": {
    "128": "img/128.png",
    "96": "img/96.png",
    "64": "img/64.png",
    "48": "img/48.png",
    "32": "img/32.png",
    "16": "img/16.png"
  }
}
